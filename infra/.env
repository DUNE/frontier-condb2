# mounted storage location on prod VMs
APP_STORAGE="/storage/local/data1/frontier"

# condb2-rest-api Podman service vars on prod VMs
CONDB2_SERVICE_PORT=8888
CONDB2_SERVICE_URL=condb2-rest-api

# frontier-server Podman service vars on prod VMs
FRONTIER_GROUP=dunefrontier
FRONTIER_USER=dunefrontier
FRONTIER_SERVICE_PORT=8000
FRONTIER_REL="https://frontier.cern.ch/dist/rpms/RPMS/noarch/frontier-release-1.3-1.noarch.rpm"